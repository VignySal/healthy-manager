<!-- meal-card 模板 -->
<template name="meal-card">
  <view class="meal-card">
    <view class="meal-header">
      <text class="meal-icon">{{icon}}</text>
      <text class="meal-title">{{title}}</text>
      <text class="meal-count">{{items.length}} 项</text>
    </view>
    <view class="meal-list">
      <view class="food-item" wx:for="{{items}}" wx:key="id" bindtap="viewFoodDetail" data-food="{{item}}" data-meal-type="{{type}}" data-index="{{index}}">
        <view class="food-image" wx:if="{{item.image}}">
          <image src="{{item.image}}" mode="aspectFill"></image>
        </view>
        <view class="food-info">
          <text class="food-name">{{item.name}}</text>
          <text class="food-calories">{{item.calories}} 千卡{{item.shareCount && item.shareCount > 1 ? ' (总:' + (item.inputCalories ? item.inputCalories : item.calories * item.shareCount) + '千卡/' + item.shareCount + '人)' : ''}}</text>
          <text class="food-time">{{item.time}}</text>
        </view>
        <view class="delete-btn" catchtap="deleteRecord" data-meal-type="{{type}}" data-index="{{index}}">
          <text class="delete-icon">✕</text>
        </view>
      </view>
    </view>
  </view>
</template>

<view class="container">
  <!-- 日期选择器 -->
  <view class="date-section">
    <picker mode="date" value="{{currentDate}}" bindchange="bindDateChange">
      <view class="picker-box">
        <text class="picker-label">选择日期：</text>
        <text class="picker-value">{{currentDate}}</text>
        <text class="picker-icon">📅</text>
      </view>
    </picker>
    <view class="date-nav">
      <view class="date-nav-btn" bindtap="goToPrevDay">
        <text class="nav-arrow">‹</text>
        <text class="nav-text">前一天</text>
      </view>
      <view class="date-nav-btn" bindtap="goToNextDay">
        <text class="nav-text">后一天</text>
        <text class="nav-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 环形进度条区域 -->
  <view class="progress-section">
    <view class="progress-card">
      <text class="progress-title">当日卡路里摄入</text>

      <view class="progress-circle-container">
        <canvas type="2d" id="progressCanvas" class="progress-canvas"></canvas>
        <view class="progress-inner">
          <text class="progress-calories">{{totalCalories}}</text>
          <text class="progress-label">/ {{dailyGoal}}</text>
          <text class="progress-unit">千卡</text>
        </view>
      </view>

      <view class="progress-tips">
        <text class="progress-percentage">{{progressPercentage}}%</text>
        <text class="progress-status">{{progressStatus}}</text>
      </view>
    </view>
  </view>

  <!-- 饮食记录列表 -->
  <view class="meals-section">
    <block wx:for="{{mealTypes}}" wx:key="key">
      <template wx:if="{{meals[item.key].length > 0}}" is="meal-card" data="{{icon: item.icon, title: item.title, type: item.key, items: meals[item.key]}}"></template>
    </block>

    <!-- 空状态提示 -->
    <view class="empty-state" wx:if="{{hasNoRecords}}">
      <text class="empty-icon">🍽️</text>
      <text class="empty-text">还没有记录饮食哦</text>
      <text class="empty-hint">点击下方按钮开始记录</text>
    </view>
  </view>

  <!-- 食物编辑弹窗 -->
  <view class="edit-dialog" wx:if="{{showEditDialog}}">
    <view class="dialog-mask" catchtap="closeEditDialog"></view>
    <view class="dialog-content">
      <view class="dialog-header">
        <text class="dialog-title">编辑食物信息</text>
        <text class="dialog-close" catchtap="closeEditDialog">×</text>
      </view>
      <view class="dialog-body">
        <view class="edit-field">
          <text class="edit-label">食物名称</text>
          <input class="edit-input" placeholder="请输入食物名称"
                 value="{{editName}}" bindinput="onNameInput" />
        </view>
        <view class="edit-field">
          <text class="edit-label">卡路里（千卡）</text>
          <input class="edit-input" type="number" placeholder="请输入卡路里"
                 value="{{editCalories}}" bindinput="onCaloriesInput" />
        </view>
        <view class="edit-field">
          <text class="edit-label">一起吃饭的人数</text>
          <input class="edit-input" type="number" placeholder="请输入人数"
                 value="{{editShareCount}}" bindinput="onShareCountInput" />
          <text class="edit-hint">记录一起吃饭的人数，用于参考</text>
        </view>
        <view class="edit-field">
          <text class="edit-label">摄入时间</text>
          <picker mode="time" value="{{editTime}}" bindchange="onTimeChange">
            <view class="edit-picker">{{editTime || '请选择时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="dialog-footer">
        <button class="dialog-btn dialog-btn-cancel" catchtap="closeEditDialog">取消</button>
        <button class="dialog-btn dialog-btn-save" catchtap="saveFoodEdit">保存</button>
      </view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view class="add-btn-section">
    <button class="add-btn" bindtap="goToCalorie">
      <text class="add-icon">+</text>
      <text class="add-text">添加食物</text>
    </button>
  </view>
</view>
