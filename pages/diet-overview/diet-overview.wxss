.container {
  padding: 30rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: linear-gradient(135deg, var(--bg-page) 0%, var(--primary-bg) 100%);
}

/* 日期选择器 */
.date-section {
  margin-bottom: 40rpx;
}

.picker-box {
  background: var(--bg-white);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.1);
}

.picker-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.picker-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary);
}

.picker-icon {
  font-size: 32rpx;
  color: var(--primary);
}

/* 日期前后导航 */
.date-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 24rpx;
}

.date-nav-btn {
  flex: 1;
  background: var(--bg-white);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.1);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.date-nav-btn:active {
  background: var(--primary-bg-light);
  border-color: var(--primary);
}

.nav-arrow {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary);
  line-height: 1;
}

.nav-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 进度条区域 */
.progress-section {
  margin-bottom: 50rpx;
}

.progress-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(76, 175, 80, 0.15);
  text-align: center;
}

.progress-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 40rpx;
  display: block;
}

.progress-circle-container {
  width: 300rpx;
  height: 300rpx;
  margin: 0 auto 40rpx;
  position: relative;
}

.progress-canvas {
  width: 100%;
  height: 100%;
}

.progress-inner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--bg-white);
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.progress-calories {
  font-size: 56rpx;
  font-weight: bold;
  color: var(--primary);
  line-height: 1;
}

.progress-label {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

.progress-unit {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.progress-tips {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.progress-percentage {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary);
}

.progress-status {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 餐次卡片 */
.meal-card {
  background: var(--bg-white);
  border-radius: var(--radius-md);
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.meal-header {
  background: #F8FBF8;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--primary-bg-light);
}

.meal-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.meal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  flex: 1;
}

.meal-count {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-bg-light);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.meal-list {
  padding: 20rpx 0;
}

.food-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
  position: relative;
}

.food-item:last-child {
  border-bottom: none;
}

.food-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.food-image image {
  width: 100%;
  height: 100%;
}

.food-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.food-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.food-calories {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.food-time {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.delete-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary-bg-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.delete-icon {
  font-size: 20rpx;
  color: var(--primary);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  margin: 40rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 添加按钮 */
.add-btn-section {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
}

.add-btn {
  background: var(--primary);
  color: white;
  border-radius: var(--radius-round);
  padding: 24rpx 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-green-lg);
  font-size: 28rpx;
  font-weight: bold;
  min-width: 200rpx;
}

.add-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.add-text {
  font-size: 28rpx;
}

/* 编辑弹窗样式 */
.edit-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.dialog-content {
  position: relative;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.dialog-header {
  background: var(--primary);
  padding: 32rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: bold;
  color: white;
}

.dialog-close {
  font-size: 40rpx;
  color: white;
  font-weight: 300;
  line-height: 1;
}

.dialog-body {
  padding: 40rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.edit-field {
  margin-bottom: 32rpx;
}

.edit-field:last-child {
  margin-bottom: 0;
}

.edit-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.edit-value {
  font-size: 30rpx;
  color: var(--text-primary);
  display: block;
  padding: 16rpx 20rpx;
  background: var(--bg-page);
  border-radius: var(--radius-sm);
}

.edit-input {
  font-size: 30rpx;
  color: var(--text-primary);
  padding: 16rpx 20rpx;
  background: var(--bg-page);
  border-radius: var(--radius-sm);
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.edit-input:focus {
  border-color: var(--primary);
  background: var(--bg-white);
}

.edit-picker {
  font-size: 30rpx;
  color: var(--text-primary);
  padding: 16rpx 20rpx;
  background: var(--bg-page);
  border-radius: var(--radius-sm);
  border: 2rpx solid transparent;
}

.edit-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  display: block;
  margin-top: 8rpx;
}

.dialog-footer {
  display: flex;
  border-top: 2rpx solid #f0f0f0;
}

.dialog-btn {
  flex: 1;
  padding: 28rpx;
  font-size: 30rpx;
  border-radius: 0;
  border: none;
  background: transparent;
}

.dialog-btn::after {
  border: none;
}

.dialog-btn-cancel {
  color: var(--text-secondary);
  border-right: 1rpx solid #f0f0f0;
}

.dialog-btn-save {
  color: var(--primary);
  font-weight: bold;
}