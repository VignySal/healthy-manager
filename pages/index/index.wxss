.container {
  min-height: 100vh;
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-section {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.logo-icon {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.upload-section {
  margin-bottom: 40rpx;
}

.upload-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.preview-area {
  position: relative;
  width: 100%;
  height: 500rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f9f9f9;
}

.preview-image {
  width: 100%;
  height: 100%;
}

/* 多图预览网格 */
.preview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.preview-item {
  position: relative;
  width: calc(33.33% - 12rpx);
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f9f9f9;
}

.preview-thumb {
  width: 100%;
  height: 100%;
}

.preview-item .remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-item .remove-icon {
  color: white;
  font-size: 36rpx;
  line-height: 1;
}

.add-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx dashed #ddd;
  background: #fafafa;
  box-sizing: border-box;
}

.add-icon {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.upload-area {
  width: 100%;
  height: 400rpx;
  border: 4rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.upload-text {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
}

.tips-section {
  margin-bottom: 40rpx;
}

.tips-card {
  background: linear-gradient(135deg, #fff9e6 0%, #fff3cd 100%);
  border-radius: 20rpx;
  padding: 30rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #856404;
  margin-bottom: 24rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: center;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #664d03;
}

.action-section {
  margin-bottom: 60rpx;
}

.btn-full {
  width: 100%;
  padding: 28rpx;
  font-size: 34rpx;
}

.btn-action {
  width: 100%;
  padding: 28rpx;
  font-size: 34rpx;
}

.feature-section {
  text-align: center;
}

.feature-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 40rpx;
}

.feature-list {
  display: flex;
  justify-content: space-around;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.feature-text {
  font-size: 26rpx;
  color: #666;
}

/* 功能按钮区域 */
.feature-buttons {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.feature-button-group {
  display: flex;
  gap: 30rpx;
}

.feature-button {
  flex: 1;
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s ease;
}

.feature-button:active {
  transform: scale(0.98);
}

.feature-button-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.feature-button-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 骨架屏 */
.skeleton-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.skeleton-block,
.skeleton-line {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 12rpx;
}

.skeleton-image {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.skeleton-line {
  height: 32rpx;
  margin-bottom: 20rpx;
}

.skeleton-line-long {
  width: 80%;
}

.skeleton-line-short {
  width: 50%;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}