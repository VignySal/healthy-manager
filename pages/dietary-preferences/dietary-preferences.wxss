.container {
  padding: 24rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--bg-page);
}

/* 分区 */
.section {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 34rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
}

.section-hint {
  font-size: 22rpx;
  color: var(--text-hint);
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.section-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 20rpx;
  line-height: 1.5;
}

/* 标签网格 */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 14rpx 28rpx;
  border-radius: var(--radius-round);
  font-size: 26rpx;
  color: var(--text-secondary);
  background: #f5f5f5;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tag-active {
  color: #fff;
  background: #4CAF50;
  border-color: #4CAF50;
}

.tag-remove {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #fff;
  opacity: 0.8;
}

.add-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  gap: 16rpx;
}

.add-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: var(--radius-md);
  color: var(--text-primary);
}

.add-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #fff;
  background: #4CAF50;
  border-radius: var(--radius-md);
  white-space: nowrap;
}

.add-btn-cancel {
  background: #999;
}

.add-btn:active {
  opacity: 0.9;
}

/* 编辑模式 */
.edit-toggle {
  font-size: 24rpx;
  color: #4CAF50;
  padding: 6rpx 18rpx;
  border: 2rpx solid #4CAF50;
  border-radius: 20rpx;
  margin-left: auto;
}

.tag-editing {
  border-color: #FF6B35;
  border-style: dashed;
}

/* 辣度选项 */
.option-row {
  display: flex;
  gap: 16rpx;
}

.option-chip {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-secondary);
  background: #f5f5f5;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.option-active {
  color: #fff;
  background: #FF6B35;
  border-color: #FF6B35;
  font-weight: 600;
}

/* 卡路里目标输入 */
.calorie-goal-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.calorie-goal-input {
  flex: 1;
  height: 80rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: 0 24rpx;
  background: #f9f9f9;
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.calorie-goal-input:focus {
  border-color: #4CAF50;
  background: var(--bg-white);
}

.calorie-goal-unit {
  font-size: 28rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

/* 备注输入 */
.notes-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  background: #f9f9f9;
  border-radius: var(--radius-md);
  padding: 20rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.notes-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 10rpx;
}

/* 自动保存提示 */
.auto-save-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-hint);
  padding: 30rpx 0 20rpx;
}
