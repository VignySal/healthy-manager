.container {
  min-height: 100vh;
  padding: 40rpx 30rpx;
}

.result-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.result-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.result-subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 照片卡片 - 与冰箱清空大师页面一致 */
.photo-section {
  margin-bottom: 40rpx;
}

.photo-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.preview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.preview-item {
  position: relative;
  width: calc(33.33% - 12rpx);
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f9f9f9;
}

.preview-thumb {
  width: 100%;
  height: 100%;
}

.ingredients-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.ingredients-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ingredient-tag {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
  color: white;
  padding: 10rpx 16rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  box-shadow: var(--shadow-green);
}

.tag-remove {
  margin-left: 8rpx;
  font-size: 30rpx;
  line-height: 1;
  opacity: 0.8;
}

.empty-ingredients {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
  border: 2rpx dashed #ddd;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
  text-align: left;
  margin-left: 24rpx;
}

.add-section {
  margin-bottom: 30rpx;
}

.add-card {
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 30rpx;
  box-shadow: var(--shadow-sm);
}

.add-title {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.add-input-wrapper {
  display: flex;
  gap: 16rpx;
}

.add-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.add-btn {
  background: var(--primary);
  color: white;
  border-radius: var(--radius-sm);
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  border: none;
  margin: 0;
}

.add-btn::after {
  border: none;
}

.common-ingredients {
  margin-bottom: 30rpx;
}

.common-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.common-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.common-item {
  background: #f0f0f0;
  color: #666;
  padding: 14rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.time-section {
  margin-bottom: 30rpx;
}

.time-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.time-list {
  display: flex;
  gap: 16rpx;
}

.time-item {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.time-item.active {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
  color: white;
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.time-value {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 4rpx;
}

.time-unit {
  font-size: 22rpx;
  opacity: 0.9;
  display: block;
}

.time-custom-input {
  width: 100rpx;
  height: 48rpx;
  font-size: 24rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  margin-top: 8rpx;
  color: inherit;
}

.cooking-mode-section {
  margin-bottom: 30rpx;
}

.cooking-mode-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.cooking-mode-list {
  display: flex;
  gap: 16rpx;
}

.cooking-mode-item {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.cooking-mode-item.active {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
  color: white;
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.cooking-mode-item.disabled {
  background: #f5f5f5;
  color: #ccc;
  border-color: #e0e0e0;
  opacity: 0.6;
}

.cooking-mode-item.disabled .mode-icon,
.cooking-mode-item.disabled .mode-name,
.cooking-mode-item.disabled .mode-desc {
  color: #ccc;
}

.mode-badge {
  font-size: 20rpx;
  background: #ff9800;
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
  display: inline-block;
}

.mode-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.mode-name {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.mode-desc {
  font-size: 22rpx;
  opacity: 0.9;
  display: block;
}

.recipe-count-section {
  margin-bottom: 30rpx;
}

.recipe-count-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.recipe-count-list {
  display: flex;
  gap: 16rpx;
}

.recipe-count-item {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.recipe-count-item.active {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
  color: white;
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.recipe-count-value {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 4rpx;
}

.recipe-count-unit {
  font-size: 22rpx;
  opacity: 0.9;
  display: block;
}

.person-count-section {
  margin-bottom: 30rpx;
}

.person-count-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.person-count-list {
  display: flex;
  gap: 16rpx;
}

.person-count-item {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.person-count-item.active {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
  color: white;
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.person-count-value {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 4rpx;
}

.person-count-unit {
  font-size: 22rpx;
  opacity: 0.9;
  display: block;
}

.banquet-tip {
  margin-bottom: 30rpx;
}

.style-section {
  margin-bottom: 30rpx;
}

.style-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.style-list {
  display: flex;
  gap: 16rpx;
}

.style-item {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.style-item.active {
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
  color: white;
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.style-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.style-name {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.style-desc {
  font-size: 22rpx;
  opacity: 0.9;
  display: block;
}

.spicy-section {
  margin-bottom: 30rpx;
}

.spicy-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.option-row {
  display: flex;
  gap: 16rpx;
}

.option-chip {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.option-active {
  color: #fff;
  background: #FF6B35;
  border-color: #FF6B35;
  font-weight: 600;
}

.option-disabled {
  color: #ccc;
  background: #f0f0f0;
  border-color: #e0e0e0;
  pointer-events: none;
}

.tips-section {
  margin-bottom: 40rpx;
}

.tips-card {
  background: #e3f2fd;
  border-radius: 16rpx;
  padding: 24rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #1565c0;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-full {
  width: 100%;
  padding: 28rpx;
  font-size: 32rpx;
}

.btn-secondary {
  background: white;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 50rpx;
  box-shadow: none;
}

.btn-secondary:active {
  background: #f5f5f5;
}