.container {
  padding: 40rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
}

/* 健康分析中心头部 */
.health-header {
  text-align: center;
  padding: 50rpx 0;
  margin-bottom: 40rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(76, 175, 80, 0.3);
}

.health-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.health-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.health-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

/* 三个功能按钮横排 */
.feature-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.feature-btn {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s ease;
}

.feature-btn:active {
  transform: scale(0.95);
}

.feature-btn-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.feature-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
}

/* 日历卡片 */
.calendar-card {
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 20rpx 16rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.month-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.month-arrow {
  font-size: 24rpx;
  color: #4CAF50;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #F0F5F0;
}

.weekday-row {
  display: flex;
  margin-bottom: 6rpx;
}

.weekday-item {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
  padding: 4rpx 0;
}

.calendar-grid {
  display: flex;
  flex-direction: column;
}

.calendar-week {
  display: flex;
}

.calendar-day {
  flex: 1;
  height: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  position: relative;
  margin: 2rpx;
}

.day-today {
  background: #E8F5E9;
}

.day-today .day-number {
  color: #4CAF50;
  font-weight: bold;
}

.day-number {
  font-size: 22rpx;
  color: #333;
  line-height: 1;
}

.day-indicator {
  margin-top: 2rpx;
}

.indicator-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #4CAF50;
}

.dot-low {
  background: #4CAF50;
}

.dot-mid {
  background: #FF9800;
}

.dot-high {
  background: #F44336;
}

/* 图例 */
.calendar-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #F0F5F0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 18rpx;
  color: #999;
}

.tips-section {
  margin-top: 40rpx;
}

.tips-card {
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.tips-text {
  font-size: 26rpx;
  color: #1565c0;
}
