page {
  /* 主色调 */
  --primary: #4CAF50;
  --primary-dark: #388E3C;
  --primary-light: #81C784;
  --primary-bg: #E8F5E9;
  --primary-bg-light: #F0F5F0;

  /* 文字颜色 */
  --text-primary: #333;
  --text-secondary: #666;
  --text-hint: #999;

  /* 背景 */
  --bg-page: #f5f5f5;
  --bg-white: #ffffff;

  /* 阴影 */
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  --shadow-green: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
  --shadow-green-lg: 0 8rpx 24rpx rgba(76, 175, 80, 0.3);

  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 24rpx;
  --radius-round: 50rpx;

  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
}

.container {
  padding: 20rpx;
}

.btn-primary {
  background-color: var(--primary);
  color: white;
  border-radius: var(--radius-round);
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  border: none;
  box-shadow: var(--shadow-green);
}

.btn-primary:active {
  background-color: #45a049;
}

.card {
  background: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.ingredient-tag {
  display: inline-block;
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  margin: 8rpx;
}
