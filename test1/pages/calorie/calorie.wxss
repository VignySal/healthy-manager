.container {
  padding: 40rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
  padding: 40rpx 0;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.header-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.upload-section {
  margin-bottom: 60rpx;
}

.upload-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.preview-area {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
  min-height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.remove-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.upload-area {
  text-align: center;
  padding: 100rpx 0;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
  background: #f9f9f9;
  transition: all 0.3s ease;
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  cursor: pointer;
}

.upload-area:hover {
  border-color: #4CAF50;
  background: #f0f9f0;
}

.upload-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 32rpx;
}

.upload-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
  display: block;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 60rpx;
}

.result-section {
  margin-bottom: 60rpx;
}

.result-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

.result-item {
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
}

.result-label {
  font-size: 26rpx;
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}

.result-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  line-height: 1.4;
}

.tips-section {
  margin-top: 40rpx;
}

.tips-card {
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.tips-text {
  font-size: 26rpx;
  color: #1565c0;
}

/* 餐次选择 */
.meal-selection {
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.selection-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

.meal-options {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.meal-option {
  flex: 1;
  background: #f5f5f5;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.meal-option.active {
  background: #FFF0EA;
  border-color: #FF6B35;
  color: #FF6B35;
}

.meal-option-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-save-to-diary {
  background: #4CAF50;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-view-diary {
  background: #FF6B35;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-primary {
  background: #4CAF50;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-secondary {
  background: #f0f0f0;
  color: #333;
  border: 1rpx solid #ccc;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.btn-full {
  width: 100%;
}
